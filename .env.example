# Eagle Eye — local development
APP_NAME=Eagle Eye
APP_ENV=development
LOG_LEVEL=INFO

# Public URL of the API (used by the frontend proxy and CORS)
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Storage
DATA_DIR=./data
DATABASE_URL=sqlite+aiosqlite:///./data/eagle_eye.db

# Job runner: "local" (in-process asyncio) or "celery"
JOB_BACKEND=local
REDIS_URL=redis://localhost:6379/0

# Overpass — identify the app (required by OSM usage policy)
OSM_USER_AGENT=EagleEye/0.1 (golf-course-vectorization; local-dev)
OVERPASS_URL=https://overpass.openstreetmap.fr/api/interpreter
OVERPASS_FALLBACKS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

# Imagery (no API keys required for ESRI World Imagery / Sentinel-2 STAC)
IMAGERY_MAX_ZOOM=18
IMAGERY_MAX_TILES=400
# High-zoom crops around pins that lack an OSM green (~0.3 m at z19 in Lisbon)
IMAGERY_PIN_ZOOM=19
IMAGERY_PIN_RADIUS_M=48

# Optional keyed sources. Pin-green crops use Google Static, then Mapbox
# Satellite @2x, then ESRI z19. Nearmap / Maxar / Planet are listed only.
MAPBOX_TOKEN=
GOOGLE_MAPS_KEY=
PLANET_API_KEY=
NEARMAP_API_KEY=
MAXAR_API_KEY=

# Course catalog — pluggable, but search/discovery always go through it
# (no OpenStreetMap name search). golfapi.io is the default adapter.
# To add another API: implement the provider in
# backend/app/services/course_catalog/providers/ and set this name.
COURSE_CATALOG_PROVIDER=golfapi
COURSE_CATALOG_SEARCH_TTL_DAYS=30

# golfapi.io adapter (ignored unless COURSE_CATALOG_PROVIDER=golfapi).
# Required for course search. Limited quota. Course/club/GPS payloads are
# cached forever. Never commit a real key.
GOLFAPI_KEY=
GOLFAPI_BASE_URL=https://golfapi.io/api/v2.3

# Segmentation: imagery_fusion (color+texture+OSM prior on the mosaic). Optional ONNX/SAM weights.
SEGMENTATION_BACKEND=imagery_fusion
# SEGMENTATION_WEIGHTS=/models/segformer-golf.onnx
